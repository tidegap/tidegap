// Build settings of the Tidegap app target. MARKETING_VERSION follows the
// lockstep version in packages/core-ts/package.json (scripts/check-versions.mjs).
MARKETING_VERSION = 0.20.0
CURRENT_PROJECT_VERSION = 1

PRODUCT_NAME = Tidegap
PRODUCT_BUNDLE_IDENTIFIER = com.tidegap.mac
INFOPLIST_FILE = Tidegap/Info.plist
GENERATE_INFOPLIST_FILE = NO
CODE_SIGN_ENTITLEMENTS = Tidegap/Tidegap.entitlements

// Ad-hoc signing: no team, no notarization (R14).
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM =
ENABLE_HARDENED_RUNTIME = NO
ENABLE_APP_SANDBOX = NO

MACOSX_DEPLOYMENT_TARGET = 14.0
SDKROOT = macosx
SWIFT_VERSION = 5.0
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
COMBINE_HIDPI_IMAGES = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
SWIFT_EMIT_LOC_STRINGS = NO
