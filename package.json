{
  "name": "tidegap",
  "version": "0.1.0",
  "private": true,
  "description": "Carbon-aware scheduling for agentic AI workflows.",
  "license": "Apache-2.0",
  "author": "Vitalii Borovyk",
  "repository": {
    "type": "git",
    "url": "https://github.com/tidegap/tidegap.git"
  },
  "homepage": "https://github.com/tidegap/tidegap",
  "bugs": {
    "url": "https://github.com/tidegap/tidegap/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "gen:data": "node scripts/gen-data.mjs",
    "gen:data:check": "node scripts/gen-data.mjs && git diff --exit-code -- packages/core-ts/src/data/tables.generated.ts packages/core-py/src/tidegap/_data.py",
    "gen:brand": "node scripts/build-brand.mjs",
    "gen:images": "node scripts/render-images.mjs",
    "gen:images:check": "node scripts/check-images.mjs",
    "gen:docs": "node scripts/build-docs.mjs",
    "gen:docs:check": "node scripts/build-docs.mjs && git diff --exit-code -- apps/web/src/lib/docs.generated.ts apps/web/public/llms-full.txt",
    "gen:brand:check": "node scripts/build-brand.mjs && git diff --exit-code -- assets/brand apps/web/public/icon.svg apps/web/src/lib/brand.generated.ts packages/cli/ui/index.html",
    "build": "pnpm -r --filter=./packages/* build",
    "test": "pnpm -r --filter=./packages/* test",
    "typecheck": "pnpm -r --filter=./packages/* typecheck",
    "lint:py": "cd packages/core-py && .venv/bin/ruff check . && .venv/bin/pytest -q",
    "check:versions": "node scripts/check-versions.mjs",
    "preflight": "pnpm check:versions && pnpm gen:data:check && pnpm typecheck && pnpm test && pnpm lint:py && pnpm gen:images:check && pnpm gen:brand:check && pnpm build && pnpm gen:docs:check && node --test compat/test/shims.test.mjs compat/test/clawhub-shim.test.mjs scripts/check-versions.test.mjs scripts/build-docs.test.mjs",
    "clean": "pnpm -r --filter=./packages/* clean && rm -rf node_modules",
    "release:npm": "pnpm -r --filter=./packages/* build && pnpm --filter @tidegap/core --filter @tidegap/cli --filter @tidegap/mcp publish --access public --no-git-checks"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "opentype.js": "1.3.4",
    "playwright-core": "1.64.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server@<2.0.5": ">=2.0.5",
      "brace-expansion@<1.1.21": "^1.1.21",
      "fast-uri@<3.1.6": "^3.1.6",
      "hono@<4.13.5": "^4.13.5",
      "js-yaml@<4.3.2": "^4.3.2",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss@<=8.5.17": ">=8.5.18",
      "qs@<6.16.0": "^6.16.0",
      "sharp@<0.35.4": "^0.35.4",
      "source-map-js@<1.2.2": "^1.2.2"
    }
  }
}
