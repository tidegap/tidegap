{
  "name": "@tidegap/mcp",
  "version": "0.19.0",
  "description": "MCP server: run non-urgent LLM tasks at the cleanest grid hour before a deadline, via Batch APIs when allowed.",
  "mcpName": "io.github.tidegap/tidegap",
  "license": "Apache-2.0",
  "author": "Vitalii Borovyk",
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "tidegap-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "smoke": "node scripts/smoke-stdio.mjs",
    "dev": "node --loader tsx src/server.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tidegap/cli": "workspace:*",
    "@tidegap/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "tsx": "^4.23.15",
    "@types/node": "^22.20.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tidegap/tidegap.git",
    "directory": "packages/mcp-server"
  },
  "publishConfig": {
    "access": "public"
  }
}
