#!/usr/bin/env node
// A fake notification program for the Command channel (tests and QA).
// Usage: notify [<log file>] [--fail | --sleep]. Appends one JSON line
// {argv, input, cwd, env} to the log file (default $HOME/fake-command.log),
// where input is all of stdin and env lists the variable names it got.
// getBuiltinModule works whether Node loads this extensionless file as CommonJS or as a module.
const { appendFileSync } = process.getBuiltinModule("node:fs");
const { join } = process.getBuiltinModule("node:path");

const args = process.argv.slice(2);
const log = args.find((a) => !a.startsWith("--")) ?? join(process.env.HOME || "/tmp", "fake-command.log");
let input = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", (c) => (input += c));
process.stdin.on("end", () => {
  appendFileSync(log, `${JSON.stringify({ argv: args, input, cwd: process.cwd(), env: Object.keys(process.env).sort() })}\n`);
  if (args.includes("--fail")) process.exit(3);
  if (args.includes("--sleep")) setTimeout(() => {}, 30_000);
});
