{
  "name": "@tidegap/cli",
  "version": "0.19.0",
  "description": "The tidegap command: runs queued Tidegap LLM tasks at the cleanest grid hour before their deadline.",
  "license": "Apache-2.0",
  "author": "Vitalii Borovyk",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./usage": {
      "types": "./dist/usage/index.d.ts",
      "import": "./dist/usage/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tidegap": "./dist/index.js"
  },
  "files": [
    "dist",
    "ui",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tidegap/core": "workspace:*",
    "commander": "^12.1.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.32.0",
    "openai": ">=4.70.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "@types/node": "^22.20.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tidegap/tidegap.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
