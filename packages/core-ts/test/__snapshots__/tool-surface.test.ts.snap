          "format": "date-time",
          "kind": "string",
          "name": "until",
          "required": false,
        },
        {
          "description": "Minutes to add to the planned start, e.g. 90 for "an hour and a half later"; at most 10080 (7 days). Omit when passing preset or until.",
          "integer": true,
          "kind": "number",
          "max": 10080,
          "min": 1,
          "name": "delay_minutes",
          "required": false,
        },
        {
          "description": "When the Claude limit resets, ISO-8601 with offset, if the user says it ("my limit resets at 15:00"). Only with preset 'after_limit_reset'; must be in the future and is remembered for later tasks. Omit to use this machine's limit reading.",
          "format": "date-time",
          "kind": "string",
          "name": "reset_at",
          "required": false,
        },
      ],
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false,
        "title": "Reply to a completed task",
      },
      "description": "Send a follow-up message in a completed task's conversation, as a new queued task. Use when: the user follows up on a finished task's result. Do not use for a failed task (use retry_task) or for an unrelated new task (use schedule_task). Behavior: each call adds one task to the local queue with earlier turns as history, the same provider and model, and its own clean window; no login now; it runs later as one provider call with the original's credentials. Returns: task_id, parent_task_id, status, scheduled_for, deadline. Rejects non-completed and unknown tasks and text over 32000 characters.",
      "name": "reply_task",
      "params": [
        {
          "description": "Id of the completed task to continue, e.g. 't-3f2a…', from the check_queue_status list (status completed).",
          "kind": "string",
          "minLength": 1,
          "name": "task_id",
          "required": true,
