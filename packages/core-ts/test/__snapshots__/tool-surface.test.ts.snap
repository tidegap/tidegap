// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`tool surface — divergence canary > per-host neutral schema snapshot (review any change on BOTH hosts) 1`] = `
{
  "mcp": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Grid carbon forecast",
      },
      "description": "Return the hour-by-hour grid carbon intensity forecast for one region, up to 72 hours ahead. Use when: the user asks how clean the grid is now or later, or wants the raw curve. Do not use to pick a run time for a task (use recommend_window) or to queue work (use schedule_task). Behavior: writes nothing; reads one grid feed, no login; GB is live without a key, other zones need a feed key or get synthetic data (Source: mock). Returns: region, source, generated time, one row per hour (gCO2/kWh and band), and the cleanest and dirtiest hour. Rejects an unknown zone and lists the closest zones.",
      "name": "get_grid_forecast",
      "params": [
        {
          "description": "Grid zone code, e.g. 'US-CAL-CISO', 'GB' or 'DE'; take it from the user's location or the data center they name. \`tidegap region list\` prints the supported zones; any zone works with an Electricity Maps key. Defaults, where the host lets it be omitted, to the configured region, else the stored setting (\`tidegap region set\`), else a time-zone guess, else GB.",
          "kind": "string",
          "name": "region",
          "required": true,
        },
        {
          "description": "How many hours ahead to forecast, e.g. 12 to cover "tonight". Defaults to 24; 72 is the most.",
          "integer": true,
          "kind": "number",
          "max": 72,
          "min": 1,
          "name": "hours",
          "required": false,
        },
      ],
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Preview cleanest window",
      },
      "description": "Preview the cleanest run window for a task before its deadline, without queuing it. Use when: the user asks when a task would run or what waiting saves. Do not use to queue the task (use schedule_task) or for the raw hourly curve (use get_grid_forecast). Behavior: writes nothing; reads the grid forecast; no login and no provider key. Returns: JSON with scheduled_for, intensity and band, estimated_carbon_g_co2, estimated_savings_vs_now_pct, batch_eligible, grid_source (mock = synthetic), alternatives, reasoning; routing_preview with 2+ candidates. Rejects a past deadline and an unknown zone.",
      "name": "recommend_window",
      "params": [
        {
          "description": "When the task must be finished: ISO-8601 with a UTC offset, in the future. Convert the user's words, e.g. "by 8am tomorrow" in New York becomes '2026-05-13T08:00:00-04:00'.",
          "format": "date-time",
          "kind": "string",
          "name": "deadline",
          "required": true,
        },
        {
          "description": "Grid zone the task would run against, e.g. 'US-CAL-CISO' or 'FR'. \`tidegap region list\` prints the supported zones; any zone works with an Electricity Maps key. Defaults, where the host lets it be omitted, to the configured region, else the stored setting (\`tidegap region set\`), else a time-zone guess, else GB.",
          "kind": "string",
          "minLength": 1,
          "name": "region",
          "required": true,
        },
        {
          "description": "Hard cap on the task's estimated grams CO2e, e.g. 5. Windows above it are skipped; if no window before the deadline fits, the task fails instead of running on a dirty grid. Omit for no cap.",
          "kind": "number",
          "name": "carbon_budget_g",
          "positive": true,
          "required": false,
        },
        {
          "description": "Model name to mention in the reasoning text, e.g. 'claude-sonnet-5'; it does not change the window. Omit to leave it out.",
          "kind": "string",
          "name": "model",
          "required": false,
        },
        {
          "description": "'provider:model' pairs the user allows, e.g. ['anthropic:claude-haiku-4-5','ollama:llama-3-1-8b']. With 2 or more, the scheduler scores each at the chosen window on carbon, cost and latency (see route_weights), runs the winner and records the scores on the receipt; it never picks a model outside this list. Omit, or pass one entry, to keep provider and model as given. A model missing from the price table is rejected.",
          "itemKind": "string",
          "kind": "array",
          "name": "candidates",
          "required": false,
        },
        {
          "description": "How to rank candidates, e.g. {"carbon": 1} for carbon only. Weights are relative and normalized; a key left out counts as 0. Omit for the default {carbon: 0.6, cost: 0.3, latency: 0.1}. Ignored unless candidates has 2 or more entries.",
          "kind": "object",
          "name": "route_weights",
          "properties": [
            {
              "description": "Relative weight on the estimated grams CO2e at the chosen window. Omit to weight it 0 when route_weights is given.",
              "kind": "number",
              "min": 0,
              "name": "carbon",
              "required": false,
            },
            {
              "description": "Relative weight on the estimated USD list cost, batch discount included when eligible. Omit to weight it 0 when route_weights is given.",
              "kind": "number",
              "min": 0,
              "name": "cost",
              "required": false,
            },
            {
              "description": "Relative weight on speed: local beats hosted sync, which beats hosted batch. Omit to weight it 0 when route_weights is given.",
              "kind": "number",
              "min": 0,
              "name": "latency",
              "required": false,
            },
          ],
          "required": false,
        },
      ],
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false,
        "title": "Schedule task at cleanest hour",
      },
      "description": "Queue an AI task to run at the cleanest grid hour before its deadline; long deadlines go through the provider Batch API at batch price. Use when: the user defers work ("later", "tonight", "by tomorrow", "no rush", "before my limit resets"); turn that into an ISO-8601 deadline. Do not use for work the user waits on (do it now), to preview only (use recommend_window or dry_run), or to read Claude limits (use tidegap_usage). Behavior: each call adds one task to the local queue (dry_run writes nothing) and reads the grid forecast; no login. The provider call runs later, on \`tidegap tick\`, with that provider's API key or the Claude Code login. Returns: task_id (for check_queue_status), status, scheduled_for, deadline, region_source, provider, model, runs_in, estimated_carbon_g_co2, a readiness line. Rejects a past deadline, an unknown zone and a disallowed tools set.",
      "name": "schedule_task",
      "params": [
        {
          "description": "The full instruction the model receives when the window arrives, e.g. 'Summarize today's AI policy news in 5 bullets'. The run may start in a fresh session without this conversation (the reply's runs_in line says which), so name the files, decisions and constraints it needs.",
          "kind": "string",
          "minLength": 1,
          "name": "prompt",
          "required": true,
        },
        {
          "description": "When the task must be finished: ISO-8601 with a UTC offset, in the future. Convert the user's words, e.g. "by 8am tomorrow" in New York becomes '2026-05-13T08:00:00-04:00'. Omit only with deadline_kind 'quota_reset', which sets it (a value is then ignored).",
          "format": "date-time",
          "kind": "string",
          "name": "deadline",
          "required": false,
        },
        {
          "description": "Grid zone to plan against, e.g. 'US-CAL-CISO' or 'FR'; pass it only when the user names a place. \`tidegap region list\` prints the supported zones; any zone works with an Electricity Maps key. Defaults to the host's configured region (MCP: TIDEGAP_DEFAULT_REGION; OpenClaw: defaultRegion), else the stored setting (\`tidegap region set\`), else a time-zone guess, else GB. The reply's region_source names the rule that applied.",
          "kind": "string",
          "name": "region",
          "required": false,
        },
        {
          "description": "Hard cap on the task's estimated grams CO2e, e.g. 5. Windows above it are skipped; if no window before the deadline fits, the task fails instead of running on a dirty grid. Omit for no cap.",
          "kind": "number",
          "name": "carbon_budget_g",
          "positive": true,
          "required": false,
        },
        {
          "description": "Model id for the chosen provider, e.g. 'claude-sonnet-5' (anthropic) or 'gpt-6-sol' (openai). Omit for the provider default: anthropic 'claude-sonnet-5' (TIDEGAP_DEFAULT_MODEL overrides it), openai 'gpt-6-sol', gemini 'gemini-3.8-flash', ollama 'llama3.1'. With 2 or more candidates, routing may pick another model from that list.",
          "kind": "string",
          "name": "model",
          "required": false,
        },
        {
          "description": "Where the task runs. 'claude-code' uses the local Claude Code login on the next \`tidegap tick\`, with no API key (see tools); 'ollama' is a local model; the others need their API key. Defaults to 'claude-code' when queued from a Claude Code session (it then runs in a copy of that session, in its project directory), else 'anthropic'; an explicit 'anthropic' never resumes a session. 'anthropic' and 'openai' can use the 50%-cheaper Batch API when the deadline allows; the others always run synchronously.",
          "kind": "enum",
          "name": "provider",
          "required": false,
          "values": [
            "anthropic",
            "openai",
            "gemini",
            "ollama",
            "claude-code",
          ],
        },
        {
          "description": "'provider:model' pairs the user allows, e.g. ['anthropic:claude-haiku-4-5','ollama:llama-3-1-8b']. With 2 or more, the scheduler scores each at the chosen window on carbon, cost and latency (see route_weights), runs the winner and records the scores on the receipt; it never picks a model outside this list. Omit, or pass one entry, to keep provider and model as given. A model missing from the price table is rejected.",
          "itemKind": "string",
          "kind": "array",
          "name": "candidates",
          "required": false,
        },
        {
          "description": "How to rank candidates, e.g. {"carbon": 1} for carbon only. Weights are relative and normalized; a key left out counts as 0. Omit for the default {carbon: 0.6, cost: 0.3, latency: 0.1}. Ignored unless candidates has 2 or more entries.",
          "kind": "object",
          "name": "route_weights",
          "properties": [
            {
              "description": "Relative weight on the estimated grams CO2e at the chosen window. Omit to weight it 0 when route_weights is given.",
              "kind": "number",
              "min": 0,
              "name": "carbon",
              "required": false,
            },
            {
              "description": "Relative weight on the estimated USD list cost, batch discount included when eligible. Omit to weight it 0 when route_weights is given.",
              "kind": "number",
              "min": 0,
              "name": "cost",
              "required": false,
            },
            {
              "description": "Relative weight on speed: local beats hosted sync, which beats hosted batch. Omit to weight it 0 when route_weights is given.",
              "kind": "number",
              "min": 0,
              "name": "latency",
              "required": false,
            },
          ],
          "required": false,
        },
        {
          "description": "Claude Code tools for a 'claude-code' run, e.g. ['WebSearch','WebFetch'] for a research task; [] means none. Allowed: WebSearch, WebFetch, Read, Grep, Glob. Omit for the default: Read, Grep and Glob in the session's project directory for a task queued from a Claude Code session, else WebSearch and WebFetch (TIDEGAP_CLAUDE_TOOLS overrides that one). A web tool makes a task from a session run fresh, without its context. Rejected: any other name (Bash, Write, Edit, ...) and a set that mixes a file tool with a web tool, because web content is untrusted.",
          "itemKind": "string",
          "kind": "array",
          "name": "tools",
          "required": false,
        },
        {
          "description": "true previews the plan (window, carbon estimate, provider, model, runs_in) and queues nothing, e.g. to confirm with the user first. Defaults to false.",
          "kind": "boolean",
          "name": "dry_run",
          "required": false,
        },
        {
          "description": "Defaults to true: store a task that \`tidegap tick\` runs. false queues an in-memory placeholder that never calls a model (tests only) and cannot combine with not_before or after_limit_reset. Omit it in normal use.",
          "kind": "boolean",
          "name": "dispatch",
          "required": false,
        },
        {
          "description": "Absolute file path, e.g. '/tmp/digest.json'; when the task completes, { taskId, result, receipt } is written there as JSON. Omit to keep the result only in the queue (check_queue_status).",
          "kind": "string",
          "name": "output_path",
          "required": false,
        },
        {
          "description": "Regex patterns removed from the prompt before it is stored on the receipt, e.g. ['customer-[0-9]+'] for customer ids. Omit for the default, which strips API-key-looking strings.",
          "itemKind": "string",
          "kind": "array",
          "name": "redact_in_receipt",
          "required": false,
        },
        {
          "description": "Short label for queue lists, e.g. 'Weekly digest'. Defaults to the prompt's first line, cut to 80 characters; API-key-looking strings are redacted.",
          "kind": "string",
          "name": "title",
          "required": false,
        },
        {
          "description": "Defaults to 'absolute': the deadline parameter sets the due time. 'quota_reset' sets it to the next weekly subscription-quota reset minus a margin, from ~/.tidegap/config (TIDEGAP_QUOTA_RESET_<LABEL>=<weekday> <HH:MM> [<IANA zone>]; margin TIDEGAP_QUOTA_MARGIN_H_<LABEL>, default 2 hours). Use it when the user says "before my weekly limit resets". A due time more than 24 hours away can use the provider Batch API.",
          "kind": "enum",
          "name": "deadline_kind",
          "required": false,
          "values": [
            "absolute",
            "quota_reset",
          ],
        },
        {
          "description": "Which configured quota to follow with deadline_kind 'quota_reset', e.g. 'claude' or 'codex'. Omit when exactly one label is configured; rejected with any other deadline_kind.",
          "kind": "string",
          "name": "quota_provider",
          "required": false,
        },
        {
          "description": "Defaults to 'none', a one-off (also with deadline_kind 'quota_reset'). Pass 'daily' or 'weekly' when the user says "every morning" or "each Monday"; 'quota_reset' follows the weekly quota reset and needs deadline_kind 'quota_reset'. When an occurrence finishes or is skipped, the next one is queued with the same prompt; each costs one provider call. End the series with cancel_task series=true.",
          "kind": "enum",
          "name": "repeat",
          "required": false,
          "values": [
            "none",
            "daily",
            "weekly",
            "quota_reset",
          ],
        },
        {
          "description": "Claude Code session id of the conversation that queued the task. Omit it: the server finds the current session itself when the Tidegap plugin is installed. Pass it only when the host substitutes it (e.g. \${CLAUDE_SESSION_ID} in a slash command); it then wins. Values that are not 8-128 letters, digits, '-' or '_' are ignored.",
          "kind": "string",
          "name": "origin_session_id",
          "required": false,
        },
        {
          "description": "true when the user says "after my limit resets": the task starts no earlier than the Claude subscription limit reset (the latest reset of an exhausted 5-hour or weekly window, else the fuller window's reset; see tidegap_usage), then runs at the cleanest hour after it. The deadline rises to at least two hours after the reset. Fails, queuing nothing, when no limit reading exists. Defaults to false; cannot combine with not_before.",
          "kind": "boolean",
          "name": "after_limit_reset",
          "required": false,
        },
        {
          "description": "Earliest start, ISO-8601 with offset, e.g. '2026-05-12T18:00:00+02:00' for "not before 6pm" or "after lunch". The task then runs at the cleanest hour between it and the deadline; it must be in the future and not after the deadline. Omit to allow any time up to the deadline; cannot combine with after_limit_reset.",
          "format": "date-time",
          "kind": "string",
          "name": "not_before",
          "required": false,
        },
      ],
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "Show task queue",
      },
      "description": "Show the local task queue: every task in brief, or one task in full. Use when: the user asks what is queued, whether a task finished, or for its result. Do not use to change a task (use cancel_task, postpone_task, update_deadline or retry_task) or to read Claude limits (use tidegap_usage). Behavior: no network or login; marks a completed or failed task read when shown, nothing else; never changes a status. Returns: without task_id, status counts, last_tick_at and one line per task; with task_id, its prompt, result, carbon receipt and recent events. Rejects an unknown task_id.",
      "name": "check_queue_status",
      "params": [
        {
          "description": "One task's id, e.g. 't-3f2a…', from schedule_task or this tool's summary, to get its full record. Omit for the summary of all tasks.",
          "kind": "string",
          "name": "task_id",
          "required": false,
        },
      ],
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": false,
        "title": "Claude usage limits",
      },
      "description": "Report this machine's Claude Code limits: 5-hour and weekly percent used, reset times, and Codex limits if present. Use when: the user asks how much quota is left, or before heavy Claude Code work; at 90% or more, pass after_limit_reset to schedule_task. Do not use for task state (use check_queue_status). Behavior: reads the statusline reading, no API key; TIDEGAP_USAGE_OAUTH=1 calls the usage endpoint with the Claude Code login and caches it in ~/.tidegap/usage.json; never writes tasks or settings. Returns: a summary line and the usage/v1 JSON (windows, reading age, after_limit_reset wait).",
      "name": "tidegap_usage",
      "params": [
        {
          "description": "true adds claude_spend: tokens and an API list-price cost estimate for the current 5-hour window from the local Claude Code logs (total, by model, the five latest sessions), plus the tokens of recent Codex sessions. Use it when the user asks what their usage would cost; the scan takes a few seconds. Defaults to false.",
          "kind": "boolean",
          "name": "include_spend",
          "required": false,
        },
      ],
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "Cancel one task",
      },
      "description": "Cancel one queued or scheduled task by task_id; to cancel every pending task use cancel_all. Use when: the user drops one task. Do not use to run it later (use postpone_task) or to rerun a failed task (use retry_task). Behavior: marks the task cancelled in the local queue and redacts its stored prompt; no network or login. A finished task comes back unchanged; a repeat call changes nothing. A repeating task skips this occurrence and queues the next; series=true ends the series. Returns: "Task <id> status: <status>", terminated_at, and a series line when ended. Rejects an unknown task_id.",
      "name": "cancel_task",
      "params": [
        {
          "description": "Id of the task to cancel, e.g. 't-3f2a…', from the schedule_task reply or the check_queue_status list.",
          "kind": "string",
          "minLength": 1,
          "name": "task_id",
          "required": true,
        },
        {
          "description": "true also ends a repeating task's series, so no further occurrence is queued; use it for "stop this for good". Defaults to false: skip only this occurrence. No effect on a one-off task.",
          "kind": "boolean",
          "name": "series",
          "required": false,
        },
      ],
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false,
        "title": "Run task now",
      },
      "description": "Run one queued or scheduled task now, skipping its clean-grid window. Use when: the user wants the result now ("do it now"). Do not use for a failed task (use retry_task), to pick a new deadline (use update_deadline), or for a claude-code task (run \`tidegap queue run-now <id>\`). Behavior: makes one provider call at the current grid intensity; needs the task provider's key in the server env (and ANTHROPIC_API_KEY or OPENAI_API_KEY); the receipt records intensitySource=expedited. Returns: status (completed or failed) and error on failure. Rejects running, submitted, finished and unknown tasks.",
      "name": "expedite_task",
      "params": [
        {
          "description": "Id of the queued or scheduled task to run now, e.g. 't-3f2a…', from the schedule_task reply or the check_queue_status list.",
          "kind": "string",
          "minLength": 1,
          "name": "task_id",
          "required": true,
        },
      ],
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": false,
        "title": "Change task deadline",
      },
      "description": "Change the deadline of one queued or scheduled task and re-pick its cleanest window inside it. Use when: the user moves the due time, earlier or later ("by 6pm instead"). Do not use to delay the start inside the same deadline (use postpone_task), to run now (use expedite_task) or to stop it (use cancel_task). Behavior: rewrites only this task in the local queue, clears its earliest start and quota rule, re-reads the grid forecast; no login. A repeat call only re-picks the hour. Returns: status, scheduled_for, new_deadline. Rejects running, finished or unknown tasks and a past deadline.",
      "name": "update_deadline",
      "params": [
        {
          "description": "Id of the queued or scheduled task to move, e.g. 't-3f2a…', from the schedule_task reply or the check_queue_status list.",
          "kind": "string",
          "minLength": 1,
          "name": "task_id",
          "required": true,
        },
        {
          "description": "The new due time, ISO-8601 with offset, earlier or later than the current one and in the future, e.g. '2026-05-12T18:00:00+02:00' for "by 6pm instead".",
          "format": "date-time",
          "kind": "string",
          "name": "deadline",
          "required": true,
        },
      ],
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false,
        "title": "Postpone task",
      },
      "description": "Move one queued or scheduled task later; it never runs earlier than planned. Use when: the user says "tonight" or "after my limit resets"; pass exactly one of preset, until or delay_minutes. Do not use to set a new due time (use update_deadline) or to stop it (use cancel_task). Behavior: rewrites this task's earliest start in the local queue and re-picks the cleanest hour after it; after_limit_reset reads the Claude limits; no login. A repeat delay moves it again. Returns: status, not_before, scheduled_for, deadline. Rejects a target at or before the planned start, finished and unknown tasks.",
      "name": "postpone_task",
      "params": [
        {
          "description": "Id of the queued or scheduled task to move later, e.g. 't-3f2a…', from the schedule_task reply or the check_queue_status list.",
          "kind": "string",
          "minLength": 1,
          "name": "task_id",
          "required": true,
        },
        {
          "description": "A named later time, in this machine's local time: '1h' is one hour after the planned start; 'tonight' is 22:00 to 06:00 (after midnight: now to 06:00); 'tomorrow_morning' is 09:00 to 12:00 tomorrow; 'after_limit_reset' is 5 minutes after the Claude limit reset (needs reset_at, this machine's limit reading or a reset time given before). Omit when passing until or delay_minutes.",
          "kind": "enum",
          "name": "preset",
          "required": false,
          "values": [
            "1h",
            "tonight",
            "tomorrow_morning",
            "after_limit_reset",
          ],
        },
        {
