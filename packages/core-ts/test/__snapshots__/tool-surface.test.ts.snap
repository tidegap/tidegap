// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`tool surface — divergence canary > per-host neutral schema snapshot (review any change on BOTH hosts) 1`] = `
{
  "mcp": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Grid carbon forecast",
      },
      "description": "Return the hour-by-hour grid carbon intensity forecast for one region, up to 72 hours ahead. Use when: the user asks how clean the grid is now or later, or wants the raw curve. Do not use to pick a run time for a task (use recommend_window) or to queue work (use schedule_task). Behavior: writes nothing; reads one grid feed, no login; GB is live without a key, other zones need a feed key or get synthetic data (Source: mock). Returns: region, source, generated time, one row per hour (gCO2/kWh and band), and the cleanest and dirtiest hour. Rejects an unknown zone and lists the closest zones.",
      "name": "get_grid_forecast",
      "params": [
        {
          "description": "Electricity Maps grid zone code (e.g. 'US-CAL-CISO', 'US-TEX-ERCO', 'GB', 'FR', 'DE'). Must be a supported zone (\`tidegap region list\`) unless an Electricity Maps key is configured; an unknown zone is rejected with the closest matches. On hosts that allow omitting it, defaults to the host's configured region, else the stored region setting (\`tidegap region set\`), else a host-timezone guess, else GB.",
          "kind": "string",
          "name": "region",
          "required": true,
        },
        {
          "description": "Forecast horizon in hours (1-72). Defaults to 24.",
          "integer": true,
          "kind": "number",
          "max": 72,
          "min": 1,
          "name": "hours",
          "required": false,
        },
      ],
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Preview cleanest window",
      },
      "description": "Preview the cleanest run window for a task before its deadline, without queuing it. Use when: the user asks when a task would run or what waiting saves. Do not use to queue the task (use schedule_task) or for the raw hourly curve (use get_grid_forecast). Behavior: writes nothing; reads the grid forecast; no login and no provider key. Returns: JSON with scheduled_for, intensity and band, estimated_carbon_g_co2, estimated_savings_vs_now_pct, batch_eligible, grid_source (mock = synthetic), alternatives, reasoning; routing_preview with 2+ candidates. Rejects a past deadline and an unknown zone.",
      "name": "recommend_window",
      "params": [
        {
          "description": "ISO-8601 timestamp (e.g. '2026-05-13T08:00:00-04:00') by which the task must have completed. Must be in the future. Required.",
          "format": "date-time",
          "kind": "string",
          "name": "deadline",
          "required": true,
        },
        {
          "description": "Electricity Maps grid zone code (e.g. 'US-CAL-CISO', 'FR') the recommendation reasons over. Must be a supported zone (\`tidegap region list\`) unless an Electricity Maps key is configured; an unknown zone is rejected with the closest matches. On hosts that allow omitting it, defaults to the host's configured region, else the stored region setting (\`tidegap region set\`), else a host-timezone guess, else GB.",
          "kind": "string",
          "minLength": 1,
          "name": "region",
          "required": true,
        },
        {
          "description": "Optional hard cap on estimated grams CO2-equivalent for this task. Windows above the cap are dropped before the cleanest is chosen; if none inside the deadline meets the cap the task fails rather than dispatching to a dirty window.",
          "kind": "number",
          "name": "carbon_budget_g",
          "positive": true,
          "required": false,
        },
        {
          "description": "Optional vendor model name (e.g. 'claude-sonnet-5'). Affects the reasoning string only.",
          "kind": "string",
          "name": "model",
          "required": false,
        },
        {
          "description": "Optional cross-provider routing candidates: 'provider:model' strings (e.g. ['anthropic:claude-haiku-4-5','openai:gpt-6-luna','ollama:llama-3-1-8b']) the caller EXPLICITLY allows. With >= 2 entries the scheduler scores them at the chosen dispatch window on a weighted blend of carbon, cost and latency and dispatches the winner (recording the full scored list on the signed receipt). No silent model swaps — routing only ever picks from this list. Absent or a single entry leaves the provider/model behavior unchanged. Every candidate model must exist in the price table or the task is rejected loudly.",
          "itemKind": "string",
          "kind": "array",
          "name": "candidates",
          "required": false,
        },
        {
          "description": "Optional routing weights {carbon, cost, latency}, non-negative and normalized internally. Default {carbon:0.6, cost:0.3, latency:0.1}. Only used when 'candidates' has >= 2 entries.",
          "kind": "object",
          "name": "route_weights",
          "properties": [
            {
              "description": "Weight on estimated grams CO2e at the chosen window (non-negative).",
              "kind": "number",
              "min": 0,
              "name": "carbon",
              "required": false,
            },
            {
              "description": "Weight on estimated USD list cost, batch discount applied when eligible (non-negative).",
              "kind": "number",
              "min": 0,
              "name": "cost",
              "required": false,
            },
            {
              "description": "Weight on the static latency tier: local < hosted-sync < hosted-batch (non-negative).",
              "kind": "number",
              "min": 0,
              "name": "latency",
              "required": false,
            },
          ],
          "required": false,
        },
