    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false,
        "title": "Schedule task at cleanest hour",
      },
      "description": "Queue an AI task to run at the cleanest grid hour before its deadline; long deadlines go through the provider Batch API at batch price. Use when: the user defers work ("later", "tonight", "by tomorrow", "no rush", "before my limit resets"); turn that into an ISO-8601 deadline. Do not use for work the user waits on (do it now), to preview only (use recommend_window or dry_run), or to read Claude limits (use tidegap_usage). Behavior: each call adds one task to the local queue (dry_run writes nothing) and reads the grid forecast; no login. The provider call runs later, on \`tidegap tick\`, with that provider's API key or the Claude Code login. Returns: task_id (for check_queue_status), status, scheduled_for, deadline, region_source, provider, model, runs_in, estimated_carbon_g_co2, a readiness line. Rejects a past deadline, an unknown zone and a disallowed tools set.",
      "name": "schedule_task",
      "params": [
        {
          "description": "The prompt or task description to dispatch when the chosen window arrives. The run may start in a fresh session without this conversation (the reply's runs_in line says which), so name the files, decisions and constraints the task needs.",
          "kind": "string",
          "minLength": 1,
          "name": "prompt",
          "required": true,
        },
        {
          "description": "ISO-8601 timestamp (e.g. '2026-05-13T08:00:00-04:00') by which the task must have completed. Must be in the future. Required unless deadline_kind is 'quota_reset', in which case it is ignored.",
          "format": "date-time",
          "kind": "string",
          "name": "deadline",
          "required": false,
        },
        {
          "description": "Grid-region override (Electricity Maps zone code such as 'US-CAL-CISO'); must be a supported zone (\`tidegap region list\`) unless an Electricity Maps key is configured. Defaults to the host's configured region (MCP: TIDEGAP_DEFAULT_REGION; OpenClaw: defaultRegion), else the stored region setting (\`tidegap region set\`), else a host-timezone guess, else GB. The reply's region_source names the rule that applied.",
          "kind": "string",
          "name": "region",
          "required": false,
        },
        {
          "description": "Optional hard cap on estimated grams CO2-equivalent for this task. Windows above the cap are dropped before the cleanest is chosen; if none inside the deadline meets the cap the task fails rather than dispatching to a dirty window.",
          "kind": "number",
          "name": "carbon_budget_g",
          "positive": true,
          "required": false,
        },
        {
          "description": "Model to dispatch with (e.g. 'claude-sonnet-5' for Anthropic, 'gpt-6-sol' for OpenAI). Defaults per provider: anthropic 'claude-sonnet-5' (TIDEGAP_DEFAULT_MODEL overrides it), openai 'gpt-6-sol', gemini 'gemini-3.8-flash', ollama 'llama3.1'. When >= 2 'candidates' are supplied, routing may overwrite this with the winning candidate.",
          "kind": "string",
          "name": "model",
          "required": false,
        },
        {
          "description": "Which provider to dispatch this task through: 'anthropic', 'openai', 'gemini', 'ollama' (local), or 'claude-code' (runs through the local Claude Code login on the next \`tidegap tick\`, no API key; see 'tools'). Defaults to 'claude-code' when the task is queued from a Claude Code session (it then runs in a copy of that session, in its project directory), else 'anthropic'. An explicit 'anthropic' never resumes a session. 'anthropic' and 'openai' can auto-route through a 50%-cheaper Batch API when the deadline allows; 'gemini', 'ollama' and 'claude-code' always dispatch synchronously.",
          "kind": "enum",
          "name": "provider",
          "required": false,
          "values": [
            "anthropic",
            "openai",
            "gemini",
            "ollama",
            "claude-code",
          ],
        },
        {
          "description": "Optional cross-provider routing candidates: 'provider:model' strings (e.g. ['anthropic:claude-haiku-4-5','openai:gpt-6-luna','ollama:llama-3-1-8b']) the caller EXPLICITLY allows. With >= 2 entries the scheduler scores them at the chosen dispatch window on a weighted blend of carbon, cost and latency and dispatches the winner (recording the full scored list on the signed receipt). No silent model swaps — routing only ever picks from this list. Absent or a single entry leaves the provider/model behavior unchanged. Every candidate model must exist in the price table or the task is rejected loudly.",
          "itemKind": "string",
          "kind": "array",
          "name": "candidates",
          "required": false,
        },
        {
          "description": "Optional routing weights {carbon, cost, latency}, non-negative and normalized internally. Default {carbon:0.6, cost:0.3, latency:0.1}. Only used when 'candidates' has >= 2 entries.",
          "kind": "object",
          "name": "route_weights",
          "properties": [
            {
              "description": "Weight on estimated grams CO2e at the chosen window (non-negative).",
              "kind": "number",
              "min": 0,
              "name": "carbon",
              "required": false,
            },
            {
              "description": "Weight on estimated USD list cost, batch discount applied when eligible (non-negative).",
              "kind": "number",
              "min": 0,
