        },
      ],
    },
    {
      "description": "Report on the Tidegap task queue. With no arguments, returns a summary of all known tasks (including tasks persisted by previous sessions — the queue survives host restarts). With task_id, returns full detail for one task, including its title, prompt, result and any carbon receipt (estimated vs actual grams, grid_source, energy_source); viewing a completed or failed task marks it read. Never changes a task's status.",
      "name": "check_queue_status",
      "params": [
        {
          "description": "If present, return only this task. If omitted, return a queue summary.",
          "kind": "string",
          "name": "task_id",
          "required": false,
        },
      ],
    },
    {
      "description": "Cancel a queued or scheduled task. Idempotent — if the task is already completed/failed/cancelled this returns the existing status without error. Throws only if task_id is unknown. Cancelling one occurrence of a repeating task skips it and queues the next one; pass series=true to end the series.",
      "name": "cancel_task",
      "params": [
        {
          "description": "The id of the task to cancel.",
          "kind": "string",
          "minLength": 1,
          "name": "task_id",
          "required": true,
        },
        {
          "description": "If true and the task repeats, also end its series: no further occurrence is queued. Default false (skip only this occurrence).",
          "kind": "boolean",
          "name": "series",
          "required": false,
        },
      ],
    },
    {
      "description": "Dispatch a queued or scheduled provider-call task immediately, bypassing the scheduler's chosen carbon window. The resulting receipt records intensitySource='expedited'. Only provider-call tasks still queued/scheduled can be expedited; running, submitted (awaiting Batch API results), or terminal (completed/failed/cancelled) tasks are rejected with an explanatory error.",
      "name": "expedite_task",
      "params": [
        {
          "description": "The id of the task to dispatch now.",
          "kind": "string",
          "minLength": 1,
          "name": "task_id",
          "required": true,
        },
      ],
    },
    {
      "description": "Re-score and reschedule a queued or scheduled task against a new deadline; the scheduler re-picks the cleanest window inside it. Throws if the task is already running or terminal, or if the new deadline is invalid or in the past.",
      "name": "update_deadline",
      "params": [
        {
          "description": "The id of the task to reschedule.",
          "kind": "string",
          "minLength": 1,
          "name": "task_id",
          "required": true,
        },
        {
          "description": "New ISO-8601 deadline. Must be in the future.",
          "format": "date-time",
          "kind": "string",
          "name": "deadline",
          "required": true,
        },
      ],
    },
    {
      "description": "Continue a completed task's conversation: creates a NEW task that sends the earlier prompt, the model's reply and this text to the same provider and model, and runs at the next clean window before its deadline (default one hour). Costs one provider call. Only completed tasks accept a reply; failed or cancelled tasks are rejected. Returns the new task id and its scheduled time.",
      "name": "reply_task",
      "params": [
        {
          "description": "The id of the completed task to reply to.",
          "kind": "string",
          "minLength": 1,
          "name": "task_id",
          "required": true,
        },
        {
          "description": "The follow-up message (1 to 32000 characters).",
          "kind": "string",
          "minLength": 1,
          "name": "text",
          "required": true,
        },
        {
          "description": "Optional ISO-8601 deadline for the reply. Defaults to one hour from now.",
          "format": "date-time",
          "kind": "string",
          "name": "deadline",
          "required": false,
        },
      ],
    },
    {
      "description": "Re-dispatch a failed provider-call task. Only valid when the task's current status is 'failed' — queued/scheduled/running/submitted/completed tasks are rejected with an explanatory error. The new run's receipt overwrites the old.",
      "name": "retry_task",
      "params": [
        {
          "description": "The id of the failed task to retry.",
          "kind": "string",
          "minLength": 1,
          "name": "task_id",
          "required": true,
        },
      ],
    },
    {
      "description": "Bulk-cancel every task in the queue that is still cancellable (status queued or scheduled). Running/completed/failed/cancelled tasks are left untouched. Optionally filter by status. Returns the number of tasks cancelled.",
      "name": "cancel_all",
      "params": [
        {
          "description": "Optional. If set, cancel only tasks in this status. Valid: 'queued', 'scheduled'. Defaults to both.",
          "kind": "enum",
          "name": "status",
          "required": false,
          "values": [
            "queued",
            "scheduled",
          ],
        },
      ],
    },
    {
      "description": "Set or change how a scheduled task's result is delivered when it completes. Call this right after schedule_task, once you have ASKED the user how they want the result. The user may pick several modes. Modes: chat (their active OpenClaw chat), telegram, webhook (needs webhook_url), file (needs file_path; format md/html/txt/json/pdf), queue (no push — retrievable via check_queue_status), os (a native desktop notification on the gateway host). PRIVACY BOUNDARY — queue is the only mode that transmits nothing (the result stays in the local ledger; read it back with check_queue_status). chat delivers through the gateway's configured chat channel, which on a Telegram-backed gateway is the SAME Telegram Bot API path as the telegram mode — do not describe chat to the user as staying inside OpenClaw. telegram sends the FULL result to a third-party service, webhook POSTs the FULL result to whatever URL is supplied (Tidegap does not restrict or inspect that destination), and file writes it to any path on the gateway host. Never pick telegram, webhook or file on the user's behalf: confirm the destination with them first, and for sensitive tasks prefer queue. Default if the user is unsure: chat.",
      "name": "set_delivery",
      "params": [
        {
          "description": "The id returned by schedule_task.",
          "kind": "string",
          "minLength": 1,
          "name": "task_id",
          "required": true,
        },
        {
          "description": "One or more delivery modes the user chose.",
          "itemKind": "enum",
          "kind": "array",
          "name": "deliver",
          "required": true,
          "values": [
            "chat",
            "telegram",
            "webhook",
            "file",
            "queue",
            "os",
          ],
        },
        {
          "description": "Target URL when deliver includes 'webhook'.",
          "kind": "string",
          "name": "webhook_url",
          "required": false,
        },
        {
          "description": "Output path when deliver includes 'file'.",
          "kind": "string",
          "name": "file_path",
          "required": false,
        },
        {
          "description": "Report format for 'file' delivery: md, html, txt, json, or pdf (pdf renders the HTML report via puppeteer if installed on the gateway). Default: md.",
          "kind": "enum",
          "name": "file_format",
          "required": false,
          "values": [
            "md",
            "html",
            "txt",
            "json",
            "pdf",
          ],
        },
      ],
    },
  ],
}
