          "kind": "string",
          "name": "quota_provider",
          "required": false,
        },
        {
          "description": "Repeat rule. Defaults to 'none' (a one-off), also for deadline_kind 'quota_reset'; pass 'weekly' (or 'daily') to repeat. 'quota_reset' follows the weekly quota reset and needs deadline_kind 'quota_reset'. When an occurrence finishes (or is cancelled as a skip), the next one is queued automatically with the same prompt; each occurrence costs one provider call. Stop the series with cancel_task series=true.",
          "kind": "enum",
          "name": "repeat",
          "required": false,
          "values": [
