// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`tool surface — divergence canary > per-host neutral schema snapshot (review any change on BOTH hosts) 1`] = `
{
  "mcp": [
    {
      "description": "Return the projected electricity-grid carbon intensity for a region, hour by hour. Use this when deciding whether to run an expensive AI task now or defer it — intensity is reported in grams CO2-equivalent per kWh with a categorical band (very_clean / clean / average / dirty / very_dirty). Read-only; does not touch the task queue.",
      "name": "get_grid_forecast",
      "params": [
        {
          "description": "Electricity Maps grid zone code (e.g. 'US-CAL-CISO', 'US-TEX-ERCO', 'GB', 'FR', 'DE'). On hosts that allow omitting it, defaults to the configured region, else a host-timezone guess, else GB.",
          "kind": "string",
          "name": "region",
          "required": true,
        },
        {
          "description": "Forecast horizon in hours (1-72). Defaults to 24.",
          "integer": true,
          "kind": "number",
          "max": 72,
          "min": 1,
          "name": "hours",
          "required": false,
        },
      ],
    },
    {
      "description": "Return the optimal carbon-aware execution window for a task WITHOUT scheduling it. Use this for non-committal planning — to see when the cleanest grid moment falls inside the deadline (and the savings vs running now) before deciding whether to commit via schedule_task. Returns the chosen window, top alternatives, a batch_eligible flag, the grid_source (which feed produced the forecast — 'mock' means synthetic data), and a one-line reasoning string. Read-only; does not touch the task queue.",
      "name": "recommend_window",
      "params": [
        {
          "description": "ISO-8601 timestamp (e.g. '2026-05-13T08:00:00-04:00') by which the task must have completed. Must be in the future. Required.",
          "format": "date-time",
          "kind": "string",
          "name": "deadline",
          "required": true,
        },
        {
          "description": "Electricity Maps grid zone code (e.g. 'US-CAL-CISO', 'FR') the recommendation reasons over. On hosts that allow omitting it, defaults to the configured region, else a host-timezone guess, else GB.",
          "kind": "string",
          "minLength": 1,
          "name": "region",
          "required": true,
        },
        {
          "description": "Optional hard cap on estimated grams CO2-equivalent for this task. Windows above the cap are dropped before the cleanest is chosen; if none inside the deadline meets the cap the task fails rather than dispatching to a dirty window.",
          "kind": "number",
          "name": "carbon_budget_g",
          "positive": true,
          "required": false,
        },
        {
          "description": "Optional vendor model name (e.g. 'claude-sonnet-5'). Affects the reasoning string only.",
          "kind": "string",
          "name": "model",
          "required": false,
        },
        {
          "description": "Optional cross-provider routing candidates: 'provider:model' strings (e.g. ['anthropic:claude-haiku-4-5','openai:gpt-6-luna','ollama:llama-3-1-8b']) the caller EXPLICITLY allows. With >= 2 entries the scheduler scores them at the chosen dispatch window on a weighted blend of carbon, cost and latency and dispatches the winner (recording the full scored list on the signed receipt). No silent model swaps — routing only ever picks from this list. Absent or a single entry leaves the provider/model behavior unchanged. Every candidate model must exist in the price table or the task is rejected loudly.",
          "itemKind": "string",
          "kind": "array",
          "name": "candidates",
          "required": false,
        },
        {
          "description": "Optional routing weights {carbon, cost, latency}, non-negative and normalized internally. Default {carbon:0.6, cost:0.3, latency:0.1}. Only used when 'candidates' has >= 2 entries.",
          "kind": "object",
          "name": "route_weights",
          "properties": [
            {
              "description": "Weight on estimated grams CO2e at the chosen window (non-negative).",
              "kind": "number",
              "min": 0,
              "name": "carbon",
              "required": false,
            },
            {
              "description": "Weight on estimated USD list cost, batch discount applied when eligible (non-negative).",
              "kind": "number",
              "min": 0,
              "name": "cost",
              "required": false,
            },
            {
              "description": "Weight on the static latency tier: local < hosted-sync < hosted-batch (non-negative).",
              "kind": "number",
              "min": 0,
              "name": "latency",
              "required": false,
            },
          ],
          "required": false,
        },
      ],
    },
    {
      "description": "Queue an AI task to run during off-peak hours inside the given deadline. Three parallel wins: (1) lighter on the electricity grid — deferring non-urgent tasks smooths projected AI compute demand; (2) 50% of sync list price (projected) — auto-routes through Anthropic/OpenAI Batch APIs when the deadline allows; (3) lower carbon — dispatch at the cleanest electricity-grid hour. Invoke this tool whenever the user phrases a request with deferral language: "do this later", "by tomorrow", "tonight", "overnight", "by EOD", "sometime this week", "when you have a moment", "remind me to", "queue this up", "schedule this", "no rush", "not urgent". Convert the user's wording to an ISO-8601 deadline and pass the task as the prompt. Returns a task_id you can later check with check_queue_status. Good fits: nightly digests, batch summaries, research sweeps, evaluator runs, multi-step report generation — anything the user is fine waiting on. Do NOT use for live chat, interactive code edits, or any task the user is actively waiting to see complete.",
      "name": "schedule_task",
      "params": [
        {
          "description": "The prompt or task description to dispatch when the chosen window arrives.",
          "kind": "string",
          "minLength": 1,
          "name": "prompt",
          "required": true,
        },
        {
          "description": "ISO-8601 timestamp (e.g. '2026-05-13T08:00:00-04:00') by which the task must have completed. Must be in the future. Required unless deadline_kind is 'quota_reset', in which case it is ignored.",
          "format": "date-time",
          "kind": "string",
          "name": "deadline",
          "required": false,
        },
        {
          "description": "Grid-region override (Electricity Maps zone code such as 'US-CAL-CISO'). Defaults to the host's configured region, else a host-timezone guess, else GB.",
          "kind": "string",
          "name": "region",
          "required": false,
        },
        {
          "description": "Optional hard cap on estimated grams CO2-equivalent for this task. Windows above the cap are dropped before the cleanest is chosen; if none inside the deadline meets the cap the task fails rather than dispatching to a dirty window.",
          "kind": "number",
          "name": "carbon_budget_g",
          "positive": true,
          "required": false,
        },
        {
          "description": "Model to dispatch with (e.g. 'claude-sonnet-5' for Anthropic, 'gpt-6-sol' for OpenAI). Defaults per provider: anthropic 'claude-sonnet-5' (TIDEGAP_DEFAULT_MODEL overrides it), openai 'gpt-6-sol', gemini 'gemini-3.8-flash', ollama 'llama3.1'. When >= 2 'candidates' are supplied, routing may overwrite this with the winning candidate.",
          "kind": "string",
          "name": "model",
          "required": false,
        },
        {
          "description": "Which provider to dispatch this task through: 'anthropic', 'openai', 'gemini', 'ollama' (local), or 'claude-code' (runs through the local Claude Code login on the next \`tidegap tick\`, no API key, read-only web tools by default; see 'tools'). Defaults to 'anthropic'. 'anthropic' and 'openai' can auto-route through a 50%-cheaper Batch API when the deadline allows; 'gemini', 'ollama' and 'claude-code' always dispatch synchronously.",
          "kind": "enum",
          "name": "provider",
          "required": false,
          "values": [
            "anthropic",
            "openai",
            "gemini",
            "ollama",
            "claude-code",
          ],
        },
        {
          "description": "Optional cross-provider routing candidates: 'provider:model' strings (e.g. ['anthropic:claude-haiku-4-5','openai:gpt-6-luna','ollama:llama-3-1-8b']) the caller EXPLICITLY allows. With >= 2 entries the scheduler scores them at the chosen dispatch window on a weighted blend of carbon, cost and latency and dispatches the winner (recording the full scored list on the signed receipt). No silent model swaps — routing only ever picks from this list. Absent or a single entry leaves the provider/model behavior unchanged. Every candidate model must exist in the price table or the task is rejected loudly.",
          "itemKind": "string",
          "kind": "array",
          "name": "candidates",
          "required": false,
        },
        {
          "description": "Optional routing weights {carbon, cost, latency}, non-negative and normalized internally. Default {carbon:0.6, cost:0.3, latency:0.1}. Only used when 'candidates' has >= 2 entries.",
          "kind": "object",
          "name": "route_weights",
          "properties": [
            {
              "description": "Weight on estimated grams CO2e at the chosen window (non-negative).",
              "kind": "number",
              "min": 0,
              "name": "carbon",
              "required": false,
            },
            {
              "description": "Weight on estimated USD list cost, batch discount applied when eligible (non-negative).",
              "kind": "number",
              "min": 0,
              "name": "cost",
              "required": false,
            },
            {
              "description": "Weight on the static latency tier: local < hosted-sync < hosted-batch (non-negative).",
              "kind": "number",
              "min": 0,
              "name": "latency",
              "required": false,
            },
          ],
          "required": false,
        },
        {
          "description": "Claude Code tools for a 'claude-code' run. Allowed names: 'WebSearch', 'WebFetch', 'Read', 'Grep', 'Glob'; [] means no tools. Omit for the default, WebSearch and WebFetch (TIDEGAP_CLAUDE_TOOLS overrides it). Any other name (Bash, Write, Edit, ...) is rejected, and so is a set that combines a file tool (Read, Grep, Glob) with a web tool. Web content is untrusted, so tools that run commands or write files are never offered.",
          "itemKind": "string",
          "kind": "array",
          "name": "tools",
          "required": false,
        },
        {
          "description": "If true, return the planned dispatch (recommended window + carbon estimate) WITHOUT persisting anything. Useful for confirmation flows.",
          "kind": "boolean",
          "name": "dry_run",
          "required": false,
        },
        {
          "description": "If true (default), persist a provider_call task body that \`tidegap tick\` (CLI) or scheduler.tick (library) can dispatch. Set to false only to enqueue a placeholder prompt without a dispatchable body (legacy in-memory mode).",
          "kind": "boolean",
          "name": "dispatch",
          "required": false,
        },
        {
          "description": "Optional absolute file path. When the task completes, Tidegap writes { taskId, result, receipt } as JSON to this path.",
          "kind": "string",
          "name": "output_path",
          "required": false,
        },
        {
          "description": "Optional regex patterns to strip from the prompt before storing it on the receipt. Omit to use the default redaction of API-key-looking strings.",
          "itemKind": "string",
          "kind": "array",
          "name": "redact_in_receipt",
          "required": false,
        },
        {
          "description": "Optional short title for the task (shown in queue lists). Defaults to the first line of the prompt, cut to 80 characters. API-key-looking strings are redacted.",
          "kind": "string",
          "name": "title",
          "required": false,
        },
        {
          "description": "How the deadline is chosen. 'absolute' (default): use 'deadline'. 'quota_reset': run before the next weekly subscription-quota reset, minus a safety margin, as configured in ~/.tidegap/config (TIDEGAP_QUOTA_RESET_<LABEL>=<weekday> <HH:MM> [<IANA zone>], optional TIDEGAP_QUOTA_MARGIN_H_<LABEL>=<hours>, default 2). Use it when the user says 'before my weekly limit resets' or similar. A deadline more than 24 hours away can route the task through the provider Batch API.",
          "kind": "enum",
          "name": "deadline_kind",
          "required": false,
          "values": [
            "absolute",
            "quota_reset",
          ],
        },
        {
          "description": "Quota label for deadline_kind 'quota_reset' (e.g. 'claude', 'codex'). Optional when exactly one label is configured.",
          "kind": "string",
          "name": "quota_provider",
          "required": false,
        },
        {
          "description": "Repeat rule. Defaults to 'none' (a one-off), also for deadline_kind 'quota_reset'; pass 'weekly' (or 'daily') to repeat. 'quota_reset' follows the weekly quota reset and needs deadline_kind 'quota_reset'. When an occurrence finishes (or is cancelled as a skip), the next one is queued automatically with the same prompt; each occurrence costs one provider call. Stop the series with cancel_task series=true.",
          "kind": "enum",
          "name": "repeat",
          "required": false,
          "values": [
            "none",
            "daily",
            "weekly",
            "quota_reset",
          ],
        },
        {
          "description": "Claude Code session id of the conversation that queued the task, so the task detail can show \`claude --resume <id>\`. Pass it only when the host substitutes it (e.g. \${CLAUDE_SESSION_ID} in a slash command); values that are not 8-128 letters, digits, '-' or '_' are ignored.",
          "kind": "string",
          "name": "origin_session_id",
          "required": false,
        },
        {
          "description": "If true, the task does not start before the Claude subscription limit resets (the latest reset of an exhausted 5-hour or weekly window, else the reset of the fuller window; see tidegap_usage); it then runs at the cleanest hour after that. The deadline rises to at least two hours after the reset. Fails, queuing nothing, when no limit state is known.",
          "kind": "boolean",
          "name": "after_limit_reset",
          "required": false,
        },
      ],
    },
    {
      "description": "Report on the Tidegap task queue. With no arguments, returns a summary of all known tasks (including tasks persisted by previous sessions — the queue survives host restarts). With task_id, returns full detail for one task, including its title, prompt, result and any carbon receipt (estimated vs actual grams, grid_source, energy_source); viewing a completed or failed task marks it read. Never changes a task's status.",
      "name": "check_queue_status",
      "params": [
        {
          "description": "If present, return only this task. If omitted, return a queue summary.",
          "kind": "string",
          "name": "task_id",
          "required": false,
        },
      ],
    },
    {
      "description": "Read-only: report the Claude Code subscription limits of this machine's login: percent used of the 5-hour and weekly windows (and per-model weekly windows when known), when each resets, how old the reading is, and the time schedule_task's after_limit_reset would wait for. Returns the usage/v1 JSON document with a one-line summary. Never changes anything. Use it before queuing heavy Claude Code work: if a window is at 90% or more, schedule with after_limit_reset.",
      "name": "tidegap_usage",
      "params": [],
    },
    {
      "description": "Cancel a queued or scheduled task. Idempotent — if the task is already completed/failed/cancelled this returns the existing status without error. Throws only if task_id is unknown. Cancelling one occurrence of a repeating task skips it and queues the next one; pass series=true to end the series.",
      "name": "cancel_task",
      "params": [
        {
          "description": "The id of the task to cancel.",
          "kind": "string",
          "minLength": 1,
          "name": "task_id",
          "required": true,
        },
        {
          "description": "If true and the task repeats, also end its series: no further occurrence is queued. Default false (skip only this occurrence).",
          "kind": "boolean",
          "name": "series",
          "required": false,
        },
      ],
    },
    {
      "description": "Dispatch a queued or scheduled provider-call task immediately, bypassing the scheduler's chosen carbon window. The resulting receipt records intensitySource='expedited'. Only provider-call tasks still queued/scheduled can be expedited; running, submitted (awaiting Batch API results), or terminal (completed/failed/cancelled) tasks are rejected with an explanatory error.",
      "name": "expedite_task",
      "params": [
        {
          "description": "The id of the task to dispatch now.",
          "kind": "string",
          "minLength": 1,
          "name": "task_id",
          "required": true,
        },
      ],
    },
    {
      "description": "Re-score and reschedule a queued or scheduled task against a new deadline; the scheduler re-picks the cleanest window inside it. Throws if the task is already running or terminal, or if the new deadline is invalid or in the past.",
      "name": "update_deadline",
      "params": [
        {
          "description": "The id of the task to reschedule.",
          "kind": "string",
          "minLength": 1,
          "name": "task_id",
          "required": true,
        },
        {
          "description": "New ISO-8601 deadline. Must be in the future.",
          "format": "date-time",
          "kind": "string",
          "name": "deadline",
          "required": true,
        },
      ],
    },
    {
      "description": "Continue a completed task's conversation: creates a NEW task that sends the earlier prompt, the model's reply and this text to the same provider and model, and runs at the next clean window before its deadline (default one hour). Costs one provider call. Only completed tasks accept a reply; failed or cancelled tasks are rejected. Returns the new task id and its scheduled time.",
      "name": "reply_task",
      "params": [
        {
          "description": "The id of the completed task to reply to.",
          "kind": "string",
          "minLength": 1,
          "name": "task_id",
          "required": true,
        },
        {
          "description": "The follow-up message (1 to 32000 characters).",
          "kind": "string",
          "minLength": 1,
          "name": "text",
          "required": true,
        },
        {
          "description": "Optional ISO-8601 deadline for the reply. Defaults to one hour from now.",
          "format": "date-time",
          "kind": "string",
          "name": "deadline",
          "required": false,
        },
      ],
    },
    {
      "description": "Re-dispatch a failed provider-call task. Only valid when the task's current status is 'failed' — queued/scheduled/running/submitted/completed tasks are rejected with an explanatory error. The new run's receipt overwrites the old.",
      "name": "retry_task",
      "params": [
        {
          "description": "The id of the failed task to retry.",
          "kind": "string",
          "minLength": 1,
          "name": "task_id",
          "required": true,
        },
      ],
    },
    {
      "description": "Bulk-cancel every task in the queue that is still cancellable (status queued or scheduled). Running/completed/failed/cancelled tasks are left untouched. Optionally filter by status. Returns the number of tasks cancelled.",
      "name": "cancel_all",
      "params": [
        {
          "description": "Optional. If set, cancel only tasks in this status. Valid: 'queued', 'scheduled'. Defaults to both.",
          "kind": "enum",
          "name": "status",
          "required": false,
          "values": [
            "queued",
            "scheduled",
          ],
        },
      ],
    },
  ],
