      "values": { "TIDEGAP_COMMAND_TIMEOUT": 2700000, "TIDEGAP_LLM_TIMEOUT": 1200000, "TIDEGAP_LLM_TIMEOUT_CLAUDE_CODE": "none" },
      "ignored": []
    },
    {
      "id": "an-invalid-line-keeps-every-valid-line",
      "config": ["TIDEGAP_COMMAND_TIMEOUT=0", "TIDEGAP_LLM_TIMEOUT=20m", "TIDEGAP_LLM_TIMEOUT_OPENAI=5x", "TIDEGAP_LLM_TIMEOUT_GEMINI=8d"],
      "values": { "TIDEGAP_LLM_TIMEOUT": 1200000 },
      "ignored": [
