    { "input": "30m", "value": 1800000, "canonical": "30m" },
    { "input": "30min", "value": 1800000, "canonical": "30m" },
    { "input": "1.5h", "value": 5400000, "canonical": "90m" },
    { "input": "2d", "value": 172800000, "canonical": "2d" },
    { "input": "300", "value": 300000, "canonical": "5m" },
