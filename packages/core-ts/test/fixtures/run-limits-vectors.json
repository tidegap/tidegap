        { "key": "TIDEGAP_LLM_TIMEOUT_", "value": "1h", "reason": "TIDEGAP_LLM_TIMEOUT takes a runner suffix of CLAUDE_CODE, ANTHROPIC, OPENAI, GEMINI or OLLAMA." }
