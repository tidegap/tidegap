{
  "$comment": [
    "Shared per-model billing vectors (KTD6, KTD7). Read by packages/core-ts/test/receipt-models.test.ts",
    "and packages/core-py/tests/test_model_usage_billing.py. Expected values come from the plain",
    "formula (input x whIn + output x whOut) x PUE 1.15 / 1000 x intensity with the data-table",
    "coefficients, not from either core. `expected: null` means fewer than two billed models",
    "(the single-model path). A count that is absent, null, not a number, negative or not finite is",
    "unreported: it is billed at the typical count (500), and the entry and `totalTokens` leave it out.",
    "When no billed entry reports a count, `totalTokens` is null: the bill leaves it out.",
    "Count strings \"NaN\" and \"Infinity\" stand for those numbers; any other string stands for itself.",
    "Entry grams are rounded half up to 0.01 g; `carbonGCo2` at the top is the unrounded sum."
  ],
  "vectors": [
    {
      "description": "two known models: each billed with its own coefficients, totals summed, exact tiers",
      "intensityGCo2PerKwh": 400,
      "modelUsage": [
        {
          "model": "claude-sonnet-5",
          "inputTokens": 1200,
          "outputTokens": 300
        },
        {
          "model": "claude-opus-5-5",
          "inputTokens": 4030,
          "outputTokens": 900
        }
      ],
      "expected": {
        "carbonGCo2": 13.013399999999997,
        "model": "claude-opus-5-5",
        "totalTokens": 6430,
        "energySource": "estimated",
        "energyResolution": "exact",
        "models": [
          {
            "model": "claude-opus-5-5",
            "inputTokens": 4030,
            "outputTokens": 900,
            "carbonGCo2": 11.77,
            "energySource": "estimated",
            "energyResolution": "exact"
          },
          {
            "model": "claude-sonnet-5",
            "inputTokens": 1200,
            "outputTokens": 300,
            "carbonGCo2": 1.24,
            "energySource": "estimated",
            "energyResolution": "exact"
          }
        ]
      }
    },
