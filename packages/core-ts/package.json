{
  "name": "@tidegap/core",
  "version": "0.19.0",
  "description": "Carbon-aware scheduling for agentic AI workflows — core TypeScript library.",
  "license": "Apache-2.0",
  "author": "Vitalii Borovyk",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./grid": {
      "types": "./dist/grid.d.ts",
      "import": "./dist/grid.js"
    },
    "./energy": {
      "types": "./dist/energy.d.ts",
      "import": "./dist/energy.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.5.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.32.0",
    "openai": ">=4.70.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "openai": "^7.34.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tidegap/tidegap.git",
    "directory": "packages/core-ts"
  },
  "publishConfig": {
    "access": "public"
  }
}
